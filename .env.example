# Copiá este archivo como .env.local y completá el valor.

# Token de la API del INDEC (https://api.indec.gob.ar). Solo se usa en el servidor:
# no le agregues el prefijo NEXT_PUBLIC_. Sin token la app funciona igual; solo quedan
# sin datos la canasta de crianza, la indigencia y la población.
INDEC_API_TOKEN=
